! ====================================================================
! Lateral-viscosity benchmark, tests A-i, B-i, C-i (setup note by Klemann et al.):
!     bin/bench_visc3d.x examples/bench_visc3d.nml
!     runme -o runs/bench_visc3d -e visc3d -n examples/bench_visc3d.nml \
!           -p benchv3d.test=A,B,C benchv3d.forcing=heav,ramp -r
! Setup and output: docs/benchmarks/visc3d.qmd. Only lmax, l_toroidal and
! visc3d_tol are read from &vilma; the earth model, memory scheme, degree-1
! frame and grid are fixed by the benchmark.
! ====================================================================

&benchv3d
    test     = "A"         ! A | B | C
    forcing  = "heav"      ! heav (load on at t = 0) | ramp (linear over 0-10 kyr)
    time_end = 100.0e3     ! [years]
/

&vilma
    lmax       = 128
    l_toroidal = .true.    ! carry the toroidal flow driven by the structure
/
